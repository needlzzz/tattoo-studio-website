# ──────────────────────────────────────────────
#  Server
# ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Full public URL (used to build confirm/decline links in emails)
BASE_URL=https://your-domain.com

# ──────────────────────────────────────────────
#  Email (SMTP)
# ──────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
OWNER_EMAIL=owner@tattoo-studio.com
FROM_EMAIL=noreply@tattoo-studio.com
FROM_NAME=Ink & Soul Tattoo Studio

# ──────────────────────────────────────────────
#  Security
# ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
HMAC_SECRET=change_me_to_a_long_random_secret
BOOKING_TOKEN_EXPIRY_HOURS=48

# ──────────────────────────────────────────────
#  Rate limiting
# ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=10
UPLOAD_RATE_LIMIT_MAX=20

# ──────────────────────────────────────────────
#  Gallery
# ──────────────────────────────────────────────
ADMIN_UPLOAD_PASSWORD=change_me_to_a_strong_password
MAX_UPLOAD_SIZE_MB=10
